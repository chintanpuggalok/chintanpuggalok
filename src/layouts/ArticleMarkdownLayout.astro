---
import BaseLayout from "./BaseLayout.astro";

const { frontmatter } = Astro.props;
const publishedDate = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(frontmatter.publishedTime));
---

<BaseLayout
  title={`${frontmatter.title} — Chintan Puggalok`}
  description={frontmatter.description}
  image="https://create-passport-photo.chintanpuggalok.com/social-card.jpg"
  type="article"
  publishedTime={frontmatter.publishedTime}
  modifiedTime={frontmatter.modifiedTime}
>
  <main class="article-shell">
    <header class="article-header">
      <p class="eyebrow">{frontmatter.category || 'Engineering / Product build'}</p>
      <h1>{frontmatter.title}</h1>
      <p>{frontmatter.description}</p>
      <div class="article-meta"><span>By Chintan Puggalok</span><time datetime={frontmatter.publishedTime}>{publishedDate}</time><span>{frontmatter.readingTime || '8 min read'}</span></div>
    </header>
    <article class="prose"><slot /></article>
  </main>
</BaseLayout>

---
import "../styles/global.css";
import { identity } from "../../shared/portfolio";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article" | "profile";
  bare?: boolean;
}

const {
  title = `${identity.name} — Backend & Distributed Systems Engineer`,
  description = identity.shortBio,
  image = "/profile.webp",
  type = "website",
  bare = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const absoluteImage = new URL(image, Astro.site);
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: identity.name,
  jobTitle: identity.role,
  worksFor: { "@type": "Organization", name: identity.currentCompany },
  url: "https://chintanpuggalok.com",
  image: absoluteImage.toString(),
  email: `mailto:${identity.email}`,
  sameAs: [identity.links.github, identity.links.linkedin, identity.links.devto],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Indraprastha Institute of Information Technology Delhi",
  },
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#080b10" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:site_name" content={`${identity.name} Portfolio`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(type === "profile" ? { "@context": "https://schema.org", "@type": "ProfilePage", mainEntity: personSchema, url: canonical.toString() } : personSchema)} />

    <script is:inline>
      (() => {
        document.documentElement.classList.add("js");
        try {
          const saved = localStorage.getItem("portfolio-theme");
          const theme = saved === "light" ? "light" : "dark";
          document.documentElement.dataset.theme = theme;
        } catch {}
      })();
    </script>

    <!-- Retain analytics on static pages only. No analytics script runs in chat. -->
    {!bare && <>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag("js", new Date());
        gtag("config", "G-P5BJ2HRX12", {
          page_location: location.origin + location.pathname,
          page_referrer: document.referrer ? new URL(document.referrer).origin : "",
          allow_google_signals: false,
          allow_ad_personalization_signals: false
        });
        // Analytics must not compete with the useful static profile during startup.
        window.addEventListener("load", () => setTimeout(() => {
          const analytics = document.createElement("script");
          analytics.async = true;
          analytics.src = "https://www.googletagmanager.com/gtag/js?id=G-P5BJ2HRX12";
          document.head.append(analytics);
        }, 3000), { once: true });
      </script>
    </>}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {!bare && (
      <header class="site-header">
        <div class="site-header-inner">
          <a class="site-brand" href="/">
            <span class="brand-mark">CP</span>
            <span><strong>{identity.name}</strong><small>backend systems engineer</small></span>
          </a>
          <button id="site-theme" class="mobile-nav-toggle" style="display:grid" type="button" aria-label="Toggle light or dark theme">◐</button>
          <button class="mobile-nav-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="site-navigation">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          </button>
          <nav class="site-nav" id="site-navigation" aria-label="Main navigation">
            <a href="/profile" aria-current={path === "/" || path === "/profile" ? "page" : undefined}>Profile</a>
            <a href="/experience" aria-current={path.startsWith("/experience") ? "page" : undefined}>Experience</a>
            <a href="/projects" aria-current={path.startsWith("/projects") ? "page" : undefined}>Projects</a>
            <a href="/writing" aria-current={path.startsWith("/writing") ? "page" : undefined}>Writing</a>
            <a href="/contact" aria-current={path === "/contact" ? "page" : undefined}>Contact</a>
            <a class="nav-chat" href="/ask?mode=visual">Ask AI</a>
          </nav>
        </div>
      </header>
    )}
    <div id="main-content" tabindex="-1" class:list={[!bare && "page-main"]}>
      <slot />
    </div>
    {!bare && (
      <footer class="site-footer">
        <div class="site-footer-inner">
          <span>© {new Date().getFullYear()} {identity.name}. Built as a fast, static-first portfolio.</span>
          <nav class="footer-links" aria-label="Footer navigation">
            <a href={identity.links.github} target="_blank" rel="noreferrer">GitHub</a>
            <a href={identity.links.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
            <a href="/privacy">Privacy</a>
            <a href="/ask?mode=cli">Agent CLI</a>
          </nav>
        </div>
      </footer>
    )}
    {!bare && (
      <script is:inline>
        const toggle = document.querySelector(".mobile-nav-toggle[aria-controls]");
        document.querySelector("#site-theme")?.addEventListener("click", () => {
          const theme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = theme;
          try { localStorage.setItem("portfolio-theme", theme); } catch {}
        });
        const nav = document.querySelector(".site-nav");
        toggle?.addEventListener("click", () => {
          const open = toggle.getAttribute("aria-expanded") !== "true";
          toggle.setAttribute("aria-expanded", String(open));
          nav?.setAttribute("data-open", String(open));
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
            toggle.setAttribute("aria-expanded", "false"); nav?.setAttribute("data-open", "false"); toggle.focus();
          }
        });
      </script>
    )}
  </body>
</html>

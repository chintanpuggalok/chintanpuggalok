---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found — Chintan Puggalok" description="The requested portfolio page could not be found.">
  <main class="page-shell">
    <section class="page-hero">
      <p class="eyebrow">Error / 404</p>
      <h1>This route isn't in the system.</h1>
      <p>Return to the profile or ask the portfolio agent to find the information you need.</p>
      <div class="page-hero-actions"><a class="button-primary" href="/">Open portfolio</a><a class="button-secondary" href="/profile">Full profile</a></div>
    </section>
  </main>
</BaseLayout>

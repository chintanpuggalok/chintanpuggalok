---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { identity } from "../../../shared/portfolio";
---

<BaseLayout title={`Writing — ${identity.name}`} description="Technical notes on backend engineering, web infrastructure, distributed systems, and applied AI.">
  <main class="page-shell">
    <header class="page-hero">
      <p class="eyebrow">Writing / Engineering notes</p>
      <h1>Understanding systems by taking them apart.</h1>
      <p>Build notes on software systems, privacy-conscious product decisions, and engineering experiments—written with the trade-offs and evidence included.</p>
      <p>Looking for the <a href="/create-passport-photo/">free Indian passport photo maker</a>? It opens the tool hosted separately.</p>
    </header>
    <section class="section" aria-label="Technical articles">
      <div class="writing-grid">
        <a class="writing-card" href="/writing/url-forwarding">
          <span class="card-kicker">Network · Dec 29, 2024 · 4 min</span>
          <h3>How twitter.com redirects to x.com</h3>
          <p>A browser-network-console walkthrough of HTTP redirects, status codes, and URL forwarding across domains.</p>
          <span class="card-arrow">Read article <span aria-hidden="true">→</span></span>
        </a>
        <a class="writing-card" href="/writing/building-a-private-indian-passport-photo-tool/">
          <span class="card-kicker">Product engineering · Sep 30, 2026 · 8 min</span>
          <h3>How I built a privacy-first Indian passport photo maker</h3>
          <p>From local image processing and exact A4 exports to browser edge cases, measured quality work, and a native-mobile roadmap.</p>
          <span class="card-arrow">Read the build journey <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

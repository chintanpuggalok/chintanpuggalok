{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chintan-portfolio-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "OPENROUTER_MODEL": "nvidia/nemotron-3-ultra-550b-a55b:free",
    "OPENROUTER_FALLBACK_MODELS": "z-ai/glm-5.2:free,minimax/minimax-m3:free",
    "ALLOWED_ORIGINS": "https://chintanpuggalok.com,https://www.chintanpuggalok.com,https://feat-interactive-portfolio.chintan-portfolio-preview.pages.dev,http://localhost:4321,http://127.0.0.1:4321,http://localhost:4173,http://127.0.0.1:4173,http://100.84.216.98:4321,http://192.168.1.14:4321"
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
